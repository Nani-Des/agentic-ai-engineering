# Copy to .env and fill in. Never commit .env to GitHub.
# In Colab, put these in the Secrets panel (key icon) and load them with:
#   from google.colab import userdata; import os; os.environ["GEMINI_API_KEY"] = userdata.get("GEMINI_API_KEY")

# Which model provider: gemini | groq | ollama | openai | mock (offline practice)
PROVIDER=gemini
# Optional: override the default model for the provider (must support tool calling)
# MODEL=gemini-2.5-flash

GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Day 2 tracing (https://cloud.langfuse.com > Settings > API keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Day 2 API
APP_API_KEYS=dev-key
RATE_LIMIT_PER_MIN=20
